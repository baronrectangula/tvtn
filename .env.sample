# Local development credentials matching docker-compose.yaml.
# Non-secret connection settings are in config.toml.
# Export these variables before running the app; Config.Load does not read .env files.
# In Bash or Zsh, run from the project root:
#   set -a
#   source .env.sample
#   set +a
POSTGRES_USER=tvtn
POSTGRES_PASSWORD=tvtn_local_password
